{
  "manifest_version": 3,
  "name": "TCG Monitor — EB Games bridge",
  "version": "1.0.0",
  "description": "Loads EB Games category listings in this browser and forwards them to the TCG Monitor.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.ebgames.ca/*",
    "https://www.nocturnemonitors.com/*",
    "https://*.up.railway.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.ebgames.ca/shop/category/trading-cards-*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "TCG Monitor — EB Games bridge" }
}
