{
  "manifest_version": 3,
  "name": "TCG Monitor — Amazon bridge",
  "version": "1.0.0",
  "description": "Reads amazon.ca buy boxes in this browser and forwards them to the TCG Monitor.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.amazon.ca/*",
    "https://www.nocturnemonitors.com/*",
    "https://*.up.railway.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.ca/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.amazon.ca/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "TCG Monitor — Amazon bridge" },
  "minimum_chrome_version": "111"
}
