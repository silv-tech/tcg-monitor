{
  "manifest_version": 3,
  "name": "TCG Monitor — Pokemon Center bridge",
  "version": "1.0.0",
  "description": "Reads Pokemon Center product stock in this browser and forwards it to the TCG Monitor.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.pokemoncenter.com/*",
    "https://www.nocturnemonitors.com/*",
    "https://*.up.railway.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.pokemoncenter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "TCG Monitor — Pokemon Center bridge" }
}
