# Database
DATABASE_URL=postgresql+asyncpg://detector:detector_local@localhost:5433/early_sku
DATABASE_URL_SYNC=postgresql://detector:detector_local@localhost:5433/early_sku

# Proxies (optional — uses direct connection if not set)
PROXY_RESIDENTIAL_URL=
PROXY_RESIDENTIAL_US_URL=

# Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# Request settings
REQUEST_RATE_LIMIT=2.0
REQUEST_TIMEOUT=15
MAX_CONCURRENT_REQUESTS=5
